{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jambo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  // The React app, built by Vite. Unknown paths fall back to index.html so /jam/:slug loads the SPA;
  // /api/*, /parties/*, /jam/*, /mcp and the /docs redirect always reach the Worker first.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/parties/*", "/jam/*", "/mcp", "/docs", "/docs/"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "Board", "class_name": "Board" },
      { "name": "SoundQuota", "class_name": "SoundQuota" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Board"] },
    { "tag": "v2", "new_sqlite_classes": ["SoundQuota"] },
  ],
  // The share of R2's monthly free tier (10 GB-month, 1M writes, 10M reads) sound uploads may use.
  // Production and previews share one account: 24% here plus 0.1% per preview stays under 25%
  // with up to ten previews in use.
  // REALTIME_APP_ID: the Cloudflare Realtime app live voices travel through. Its token is the
  // REALTIME_APP_TOKEN secret (`wrangler secret put REALTIME_APP_TOKEN`); where it isn't set, live
  // voice isn't available (local Workers use the fake relay instead). Not in secrets.required, so
  // previews without it still deploy.
  "vars": { "SOUND_BUDGET_PERCENT": "24", "REALTIME_APP_ID": "187514afc9e3468ac58e74de3721dad8" },
  // Uploaded sounds' audio, at jams/<slug>/<soundId>.wav. The board doc only lists them.
  "r2_buckets": [{ "binding": "SOUND_FILES", "bucket_name": "jambo-sounds" }],
  // Per client address: uploads and removals, 10 a minute; uncached downloads, 120 a minute;
  // agent tool calls over MCP, 20 a minute; live voice session calls, 20 a minute.
  "ratelimits": [
    { "name": "SOUND_WRITES", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SOUND_READS", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    { "name": "AGENT_RUNS", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } },
    { "name": "CLIP_WRITES", "namespace_id": "1007", "simple": { "limit": 30, "period": 60 } },
    { "name": "LIVE_SESSIONS", "namespace_id": "1009", "simple": { "limit": 20, "period": 60 } },
  ],
  "observability": { "enabled": true },
  // Pull-request previews (Workers Builds runs `wrangler preview`). Each preview gets its own
  // isolated Board namespace and storage; this block only makes the bindings exist there.
  "previews": {
    "durable_objects": {
      "bindings": [
        { "name": "Board", "class_name": "Board" },
        { "name": "SoundQuota", "class_name": "SoundQuota" },
      ],
    },
    "vars": {
      "SOUND_BUDGET_PERCENT": "0.1",
      "REALTIME_APP_ID": "187514afc9e3468ac58e74de3721dad8",
    },
    "r2_buckets": [{ "binding": "SOUND_FILES", "bucket_name": "jambo-sounds-preview" }],
    "ratelimits": [
      { "name": "SOUND_WRITES", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
      { "name": "SOUND_READS", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } },
      { "name": "AGENT_RUNS", "namespace_id": "1006", "simple": { "limit": 20, "period": 60 } },
      { "name": "CLIP_WRITES", "namespace_id": "1008", "simple": { "limit": 30, "period": 60 } },
      { "name": "LIVE_SESSIONS", "namespace_id": "1010", "simple": { "limit": 20, "period": 60 } },
    ],
    "observability": { "enabled": true },
  },
}
